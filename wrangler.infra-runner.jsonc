// Independent Terraform executor for susanbeasles/infra.
// The infra repository owns its deployment and credentials. This config is a
// shared-code build recipe, NOT an application deployer route or binding.
// Only the Authorizer has a private RPC service binding to InfraRunner.
{
  "name": "infra-runner",
  "main": "worker/infra-runner.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "limits": { "cpu_ms": 60000 },
  "vars": {
    "ACCOUNT_ID": "1a799c6e699d2ef7e87398692ce3ad7b",
    // COMMISSIONING: existing GitHub App ID with source-read/check-write on infra.
    "GITHUB_APP_ID": "0",
    "R2_STATE_RO_TOKEN_ID": "",
    "R2_STATE_RW_TOKEN_ID": "",
    "RUNNER_ROLE": "infra"
  },
  "durable_objects": {
    "bindings": [{ "name": "RUNNER", "class_name": "RunnerJob" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerJob"] }],
  "containers": [
    {
      "class_name": "RunnerJob",
      "scheduling_policy": "durable_object",
      "images": { "runner": { "dockerfile": "./container/Dockerfile", "build_context": "./container" } }
    }
  ],
  "r2_buckets": [
    { "binding": "RUNNER_LOGS", "bucket_name": "runner-logs" },
    { "binding": "TF_PLANS", "bucket_name": "tf-plans" }
  ],
  "services": [{ "binding": "AUTHORIZER", "service": "authorizer", "entrypoint": "Authorizer" }],
  "secrets_store_secrets": [
    { "binding": "GITHUB_APP_KEY", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "DEPLOYER_GITHUB_APP_KEY" },
    { "binding": "CF_PLAN", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "CF_PLAN" },
    { "binding": "CF_APPLY", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "CF_APPLY" },
    { "binding": "R2_STATE_RO", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "R2_STATE_RO" },
    { "binding": "R2_STATE_RW", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "R2_STATE_RW" },
    { "binding": "TF_ENCRYPTION_INFRA", "store_id": "b6504fe2d5f64352954629bc7185fb79", "secret_name": "TF_ENCRYPTION_INFRA" }
  ]
}
